<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 官方 SDK 與 MEAI 相依 DLL 必須隨 Mod 輸出，才能在 RimWorld managed assembly 環境載入。 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>RimLLM Framework</AssemblyName>
    <RootNamespace>RimLLM_Framework</RootNamespace>
    <!-- Mod 發佈 (Release) 不需要 PDB 偵錯符號；Debug 與測試建置則生成 PDB 以供覆蓋率分析。 -->
    <DebugSymbols Condition="'$(Configuration)' != 'Release'">true</DebugSymbols>
    <DebugType Condition="'$(Configuration)' != 'Release'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- 確保建置時不會自動在路徑後附加 net10.0/ 資料夾 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!--
      只有 Release 會寫入實際出貨的 Assemblies/。
      注意：改動程式碼後要讓遊戲載入到新版，必須跑 `dotnet build -c Release`。
    -->
    <OutputPath Condition="'$(Configuration)' == 'Release'">..\..\Assemblies\</OutputPath>
    <OutputPath Condition="'$(Configuration)' != 'Release'">bin\$(Configuration)\</OutputPath>
    <Deterministic>true</Deterministic>
    <!-- 避免與原本 Properties/AssemblyInfo.cs 產生屬性重複衝突 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- LibraryImport 產生的封送處理程式碼需要 unsafe 區塊（SYSLIB1062）。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ChatCompletionOptions.Patch 為實驗性 API (SCME0001)，本專案刻意使用它以補救 wire 差異。
         NU1608: 套件相依版本範圍與實際解析版本不一致時的警告。
         MEAI001: FailoverChatClient / RoutingContext / FailoverChatClientAttempt 被 Microsoft 標記為評估用途。
         -->
    <NoWarn>$(NoWarn);SCME0001;NU1608;MEAI001</NoWarn>
    <!-- 使用 BannedSymbols.txt 禁用的 API 直接編譯失敗。 -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
    <!-- 直接 Reference 的組件預設會連 .xml 文件檔一起複製到 Assemblies/，出貨不需要。 -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <Authors>mushroomTW</Authors>
  </PropertyGroup>


  <!-- RimWorld 1.7 API 參考組件改由 NuGet 套件 Krafs.Rimworld.Ref 提供（可攜式建置，不依賴本機遊戲）。
       Harmony 3.0 仍取自工作坊 DLL，Private=false 不隨 Mod 出貨。 -->
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5013-unstable" />
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    遊戲本體已附帶的組件不隨 Mod 出貨，執行期直接使用遊戲那份。
    Krafs.Rimworld.Ref 收錄的就是遊戲根目錄的組件，所以只要 Krafs 有同名檔案，就從複製清單移除；
    遊戲日後多附帶的組件也會自動排除，建置不需要讀本機遊戲目錄。
    NuGet 的 ExcludeAssets 只能套在直接引用的套件上，管不到 MEAI、TypeSafeAI 等套件間接帶進來的相依，所以改用 target 過濾。
    Krafs 的清單要在 ResolvePackageFileConflicts 之前取得：衝突解析會把 Krafs 與套件重複的參考從 Reference 移除。
  -->
  <Target Name="CollectGameProvidedAssemblies" AfterTargets="ResolveLockFileReferences">
    <ItemGroup>
      <_GameProvidedAssembly Include="@(Reference)" Condition="'%(Reference.NuGetPackageId)' == 'Krafs.Rimworld.Ref'">
        <AssemblyFileName>%(Filename)</AssemblyFileName>
      </_GameProvidedAssembly>
    </ItemGroup>
  </Target>

  <!-- MatchOnMetadata 比對自訂中繼資料：兩邊路徑不同，只能以檔名對應。 -->
  <Target Name="ExcludeGameProvidedAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths>
        <AssemblyFileName>%(Filename)</AssemblyFileName>
      </ReferenceCopyLocalPaths>
      <ReferenceCopyLocalPaths Remove="@(_GameProvidedAssembly)" MatchOnMetadata="AssemblyFileName" />
    </ItemGroup>
  </Target>

  <!-- System.Security.Cryptography.ProtectedData 不另外引用：遊戲本體已附 10.0 版，編譯期由 Krafs.Rimworld.Ref 提供參考組件，不隨 Mod 出貨。 -->
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <!--
      MEAI 刻意停在 10.x：遊戲本體附帶的 Microsoft.Extensions.*（DI、Logging、Options、Configuration、Primitives）
      與 System.Diagnostics.DiagnosticSource 組件版本都是 10.0.0.0。MEAI 10.x 只相依 10.0.x 套件（組件版本固定 10.0.0.0），
      與遊戲那份一致；MEAI 11 則要求 11.0.0.0，會讓 Mod 另外出貨一份新版並與遊戲的版本衝突（MSB3277）。
      遊戲本體升級到 .NET 11 的 Extensions 之前不要升 MEAI 11；升級時一併更新 README 的版本釘選。
    -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="OpenAI" Version="2.15.0" />
    <PackageReference Include="System.ClientModel" Version="1.17.0" />
    <PackageReference Include="TypeSafeAI" Version="1.0.0" />
    <!-- 版本對齊 Microsoft.Agents.AI 1.28.0 的相依：下游 Mod 用 AF 壓縮 API 時共用這一份，不各自出貨。 -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <!-- 框架本身不用；下游 Mod 的 gRPC（RimAgent 的 A2A.Grpc）共用這一份。Google.Protobuf 的組件版本隨套件版本變動，必須 ≥ 下游要求的最低版（A2A.Grpc 1.0.0-preview4 為 3.36.2）。 -->
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
  </ItemGroup>

  <!-- SDK 優先的編譯期守門：禁止繞過 SDK 的底層 API，清單與理由見 BannedSymbols.txt。僅建置時使用，不隨 Mod 出貨。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <!-- 公開 API 守門：公開 API 的任何新增、刪除或簽章變動都要同步更新 PublicAPI.*.txt，避免不小心破壞下游 Mod。
       已發佈的 API 記在 Shipped，尚未發佈的新增記在 Unshipped；發佈新版時把 Unshipped 的內容搬到 Shipped。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
