<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SmashPhil DevTools 遊戲內整合測試（開發用伴隨 Mod，不在 .slnx 內、不隨 RimLLM Framework 出貨）。
    驗證 headless 單元測試在 Unity 被 stub 掉時看不到的部分：
    相容層 Harmony 攔截是否真的掛上、出貨 DLL 在共用 AppDomain 內能否完整解析型別、語系檔是否被遊戲注入。

    建置只會輸出到 Mod/Assemblies/，不會重建主專案；主專案改動後請先自行
    `dotnet build "Source/RimLLM Framework/RimLLM Framework.csproj" -c Release`。
  -->
  <PropertyGroup>
    <AssemblyName>RimLLM Framework.InGameTests</AssemblyName>
    <RootNamespace>RimLLM_Framework.InGameTests</RootNamespace>
    <OutputPath>Mod\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <DevToolsDll Condition="'$(DevToolsDll)' == ''">$(MSBuildThisFileDirectory)..\Libs\DevTools\DevTools.dll</DevToolsDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Mod\**" />
    <None Remove="Mod\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5013-unstable" />
    <Reference Include="Microsoft.Extensions.AI.Abstractions">
      <HintPath>..\..\Assemblies\Microsoft.Extensions.AI.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DevTools">
      <HintPath>$(DevToolsDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 參考的是 Release 出貨的 DLL（../../Assemblies），內部成員透過 InternalsVisibleTo 開放。 -->
    <Reference Include="RimLLM Framework">
      <HintPath>..\..\Assemblies\RimLLM Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Krafs.Rimworld.Ref 附帶這些組件的 10.0 版，出貨的 RimLLM Framework.dll 則相依 11.0 版（MSB3277）。
    主專案以 PackageReference 交給 NuGet 統一版本；這裡直接參考出貨 DLL，所以改用出貨目錄的版本，
    並移除 Krafs 帶進來的舊版。
  -->
  <ItemGroup>
    <ShippedDependency Include="Microsoft.Extensions.DependencyInjection.Abstractions;Microsoft.Extensions.Logging.Abstractions;Microsoft.Extensions.Primitives;System.Diagnostics.DiagnosticSource;System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <Target Name="UseShippedDependencyVersions" AfterTargets="ResolveLockFileReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_KrafsDependency Include="@(Reference)" Condition="'%(Reference.NuGetPackageId)' == 'Krafs.Rimworld.Ref' and '@(ShippedDependency->AnyHaveMetadataValue('Identity', '%(Reference.Filename)'))' == 'true'" />
      <Reference Remove="@(_KrafsDependency)" />
      <Reference Include="@(ShippedDependency)">
        <HintPath>..\..\Assemblies\%(Identity).dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <Target Name="CheckDevTools" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(DevToolsDll)')"
           Text="DevTools 1.7 DLL not found at '$(DevToolsDll)'. Pass -p:DevToolsDll=&lt;path to DevTools.dll&gt;" />
  </Target>

  <Target Name="CopyDevToolsForDevelopment" AfterTargets="Build">
    <Copy SourceFiles="$(DevToolsDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
