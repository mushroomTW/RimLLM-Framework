<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RimLLM_Framework.Tests</RootNamespace>
    <AssemblyName>RimLLM Framework.Tests</AssemblyName>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);SCME0001;NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RimLLM Framework\RimLLM Framework.csproj" />
  </ItemGroup>

  <!-- 1.7 的遊戲組件與 Harmony 3.0：直接參考並複製到測試輸出，執行期才找得到。 -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 主專案改用 Krafs.Rimworld.Ref NuGet 套件後，遊戲組件不再由 Reference 的 Private 複製；
       這裡明確把執行期所需的遊戲 DLL 複製到測試輸出，避免 FileNotFoundException。 -->
  <Target Name="CopyRimWorldRuntimeAssemblies" AfterTargets="Build">
    <Copy SourceFiles="$(RimWorldDir)Assembly-CSharp.dll;$(RimWorldDir)UnityStubs.dll;$(RimWorldDir)Waylith.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
